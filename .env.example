# ---------------------------------------------------------------------------
# WorkPilot configuration. Copy to .env and edit.
# ---------------------------------------------------------------------------

# WorkPilot refuses to start until both of these are your own (`make env` sets the secret).

# Single-user login, format "name:password" (see docs/decisions/0003).
# Forgot it? Change it here and restart.
WORKPILOT_USER=me:change-me

# Signs session cookies, encrypts stored secrets, derives the push key. 32+ random characters.
# Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it later signs you out and forgets the stored AI key.
WORKPILOT_SECRET_KEY=change-me

# Send the session cookie over HTTPS only. Keep true when hosted; false only for local http.
WORKPILOT_COOKIE_SECURE=true

# Reminders: who push services (Google, Mozilla, Apple) can contact about this server.
# "mailto:" + a real email, or your site's https URL. Apple refuses made-up addresses.
# Leave empty to turn reminders off.
WORKPILOT_PUSH_CONTACT=

# The app's port on this computer with `docker compose up`: http://localhost:8000.
WORKPILOT_PORT=8000

# Database
POSTGRES_USER=workpilot
POSTGRES_PASSWORD=workpilot
POSTGRES_DB=workpilot
# Development only: the port `make db` opens on this computer. If you change it, change it
# in WORKPILOT_DATABASE_URL too.
POSTGRES_PORT=5433
# Used when running the API outside Docker (docker compose overrides it for the app).
WORKPILOT_DATABASE_URL=postgresql+psycopg://workpilot:workpilot@localhost:5433/workpilot

# The language and the AI provider are chosen in the app during onboarding, not here.
